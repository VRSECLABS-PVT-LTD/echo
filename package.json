{
  "name": "echo-vrseclabs",
  "productName": "Echo",
  "version": "0.1.1",
  "description": "Echo by VRSecLabs: a private, open-source AI assistant that runs entirely on your computer.",
  "main": "main.js",
  "license": "GPL-3.0-only",
  "author": {
    "name": "VRSecLabs",
    "url": "https://vrseclabs.in"
  },
  "homepage": "https://vrseclabs.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VRSECLABS-PVT-LTD/echo.git"
  },
  "bugs": {
    "url": "https://github.com/VRSECLABS-PVT-LTD/echo/issues"
  },
  "keywords": [
    "ai",
    "assistant",
    "privacy",
    "local-first",
    "ollama",
    "offline",
    "electron",
    "llm"
  ],
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/unit.test.js",
    "test:model": "node test/agent.test.js && node test/api.test.js",
    "icons": "node scripts/start.js scripts/make-icons.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "in.vrseclabs.echo",
    "productName": "Echo",
    "copyright": "Copyright © 2026 VRSecLabs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "agent.js",
      "tools.js",
      "store.js",
      "scheduler.js",
      "integrations.js",
      "platform.js",
      "preload*.js",
      "renderer/**",
      "assets/**",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Echo uses Calendar and Contacts only when you ask it to add an event or call someone.",
        "NSCalendarsUsageDescription": "Echo adds events to your calendar when you ask it to.",
        "NSContactsUsageDescription": "Echo looks up a phone number only when you ask it to call someone."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Echo by VRSecLabs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Echo",
      "artifactName": "Echo-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "VRSecLabs <https://vrseclabs.in>",
      "synopsis": "Private, on-device AI assistant",
      "description": "Echo by VRSecLabs is a private AI assistant that runs entirely on your computer using Ollama."
    }
  }
}
